{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{fixtures/prepared_runs.v1.json,web/results.html}"
    }
  },
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/",
      "destination": "/api/index.py?path=showcase"
    },
    {
      "source": "/results.html",
      "destination": "/api/index.py?path=showcase/results"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}
